# Integration test credentials — copy to .env.integration and fill in values.
# NEVER commit .env.integration to git.
#
# Only set the vars for platforms you want to test.
# Tests skip automatically if their required vars are missing.

# ── Tier 1: ACP real-payment ──────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
# SHOP_STRIPE_SECRET_KEY=sk_test_...

# ── Tier 2: Shopify Catalog (read-only search, safe to run often) ─────────
# Get from: https://partners.shopify.com → Apps → your app → API access
# SHOP_SHOPIFY_CLIENT_ID=f16589a99f395f7ee5c0a25fe1cff731
# SHOP_SHOPIFY_CLIENT_SECRET=shpss_...

# ── Tier 3: Shopify UCP checkout (needs store password disabled + scope) ──
# SHOP_SHOPIFY_SHOP_PAY_TOKEN=<opaque token from Shop Pay OAuth flow>

# ── Tier 2: PayPal Fastlane sandbox ──────────────────────────────────────
# Get Client ID + Secret from: https://developer.paypal.com → My Apps → Sandbox
# Get Fastlane token by vaulting a test card via /v3/vault/payment-tokens
# (see integration testing runbook section 3.3)
# SHOP_PAYPAL_CLIENT_ID=
# SHOP_PAYPAL_CLIENT_SECRET=
# SHOP_PAYPAL_FASTLANE_TOKEN=

# ── Tier 2: Bolt sandbox ──────────────────────────────────────────────────
# Get from: https://merchant.bolt.com → API Keys
# SHOP_BOLT_API_KEY=
# SHOP_BOLT_MERCHANT_ID=
# SHOP_BOLT_TOKEN=
